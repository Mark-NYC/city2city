---
// Global footer: a closing statement on dark, minimal links.
import { primaryNav, primaryCta } from "@/data/nav";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <p class="site-footer__word">
        A church
        <br />
        of churches.
      </p>
      <nav aria-label="Footer">
        {primaryNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href={primaryCta.href}>{primaryCta.label}</a>
      </nav>
    </div>
    <p class="site-footer__bottom">&copy; {year} City2City.</p>
  </div>
</footer>
