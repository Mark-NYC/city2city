---
// A single city's evidence card. Renders "—" for any metric we don't have and
// shows a Placeholder badge for placeholder entries, so nothing fake is implied.
import type { City } from "@/data/cities";

interface Props {
  city: City;
}

const { city } = Astro.props;
const statusLabel = {
  hub: "Hub",
  emerging: "Emerging",
  immersion: "Immersion",
}[city.status];

const fmt = (n?: number) => (typeof n === "number" ? String(n) : "—");
---

<article class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
    <h3 style="font-size: var(--text-lg);">{city.name}</h3>
    {city.placeholder ? (
      <span class="badge">Placeholder</span>
    ) : (
      <span class="badge">{statusLabel}</span>
    )}
  </div>

  <ul class="card__metrics">
    <li>
      Baptisms <span>{fmt(city.fruit?.baptisms)}</span>
    </li>
    <li>
      Churches <span>{fmt(city.fruit?.churches)}</span>
    </li>
    <li>
      Stream depth <span>{fmt(city.fruit?.streamDepth)}</span>
    </li>
  </ul>

  {city.story && (
    <p style="margin-top:0.75rem; color: var(--color-muted);">{city.story}</p>
  )}
</article>
