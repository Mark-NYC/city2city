---
// Global header: wordmark, minimal nav, emphasized CTA. Sticky with a hairline
// that appears on scroll; full-screen overlay menu on mobile.
import { primaryNav, primaryCta } from "@/data/nav";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      City2City
    </a>

    <button
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      Menu
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__links">
        {primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={primaryCta.href} class="btn btn--primary nav__cta">
        {primaryCta.label}
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.getElementById("primary-nav");
  const setOpen = (open: boolean) => {
    nav?.setAttribute("data-open", String(open));
    toggle?.setAttribute("aria-expanded", String(open));
    if (toggle) toggle.textContent = open ? "Close" : "Menu";
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () =>
    setOpen(nav?.getAttribute("data-open") !== "true"),
  );
  nav
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
