---
// Global site header: brand, primary nav, and the emphasized primary CTA.
// Responsive: collapses to a toggle menu below ~48rem. The small inline script
// is the only client-side JS on the site.
import Button from "@/components/Button.astro";
import { primaryNav, primaryCta } from "@/data/nav";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      City2City
    </a>

    <button
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Toggle navigation"
      data-nav-toggle
    >
      Menu
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__links">
        {primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={primaryCta.href} variant="primary">
        {primaryCta.label}
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.getElementById("primary-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.getAttribute("data-open") === "true";
    nav?.setAttribute("data-open", String(!open));
    toggle.setAttribute("aria-expanded", String(!open));
  });
</script>
