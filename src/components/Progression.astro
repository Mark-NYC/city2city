---
// Editorial pathway: an ordered, numbered sequence (A → B → C) rendered as
// running display type rather than boxes. Reused for the involvement pathway
// and city-to-city collaboration.
interface Step {
  label: string;
  note?: string;
}

interface Props {
  steps: Step[];
  ariaLabel?: string;
}

const { steps, ariaLabel } = Astro.props;
---

<ol class="pathway" aria-label={ariaLabel}>
  {steps.map((step) => (
    <li>
      {step.label}
      {step.note && (
        <span style="font-family:var(--font-sans);font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--clay);">
          {step.note}
        </span>
      )}
    </li>
  ))}
</ol>
