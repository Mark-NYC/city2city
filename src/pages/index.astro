---
// Homepage — positioning correction pass (visual system unchanged).
// City2City is NOT an organization churches join or come under. The substance
// stays local; City2City is the collaboration between local works. Narrative:
// identity → tension → muddy boots → local/shared distinction → multiplication
// → city-to-city (horizontal) → immersions (relational) → evidence → vision.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Progression from "@/components/Progression.astro";
import Button from "@/components/Button.astro";
import Figure from "@/components/Figure.astro";
import { primaryCta } from "@/data/nav";
import { cities } from "@/data/cities";

// What collaboration between local works actually looks like.
const collaboration = [
  "Pray together",
  "Share what we're learning",
  "Steward what God is doing",
  "Work through barriers",
  "Support one another",
  "Go into the harvest together",
];

// Public-facing progression — relationship, not an admissions pipeline.
const immersionPath = [
  { label: "Immersion" },
  { label: "Relationship" },
  { label: "Shared practice" },
  { label: "Ongoing collaboration" },
];
---

<BaseLayout
  title="City2City — A Church of Churches"
  description="Local churches pursuing multiplication in their own cities and collaborating with churches and practitioners in other cities for the sake of the gospel."
>
  {/* 1 — Identity first */}
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-reveal>
        City2City
      </p>
      <h1 class="hero__title" data-reveal>
        A Church of Churches
      </h1>
      <p class="lead hero__lead" data-reveal>
        Local churches pursuing multiplication in their own cities — and
        collaborating with churches and practitioners in other cities, for the
        sake of the gospel.
      </p>
      <div class="hero__actions" data-reveal>
        <Button href={primaryCta.href} variant="primary">
          {primaryCta.label}
        </Button>
        <Button href="/vision" variant="secondary">
          See the vision
        </Button>
      </div>
    </div>
    <div class="container hero__media" data-reveal>
      <Figure
        ratio="16 / 8"
        tone="dark"
        caption="Practitioners together on a city street or in a doorway — real people, a real neighborhood, not a stage."
      />
    </div>
  </section>

  {/* 2 — Tension */}
  <section class="section dark">
    <div class="container">
      <p class="statement" data-reveal>
        Multiplication was never meant to happen alone.
      </p>
      <p class="lead" style="margin-top:1.75rem;" data-reveal>
        You don't need another organization to come under. You need
        relationships with other practitioners who are actually doing the work —
        in their cities, like you are in yours.
      </p>
    </div>
  </section>

  {/* 3 — Muddy boots */}
  <section class="section">
    <div class="container split split--media-wide">
      <div class="stack" data-reveal>
        <p class="eyebrow">Muddy boots</p>
        <h2 class="section__title" style="margin-top:0;">
          It starts with people doing the work.
        </h2>
        <p class="prose">
          Collaboration between cities only means something when the local work
          is real. Not people who agree with multiplication in theory —
          practitioners carrying responsibility in an actual place.
        </p>
        <ul class="practices">
          <li>Making disciples</li>
          <li>Leading churches</li>
          <li>Pursuing multiplication</li>
          <li>Carrying local responsibility</li>
        </ul>
      </div>
      <Figure
        data-reveal
        ratio="4 / 5"
        caption="A practitioner making disciples in an everyday setting — a home, a kitchen table, a workplace."
      />
    </div>
  </section>

  {/* 4 — The distinction: local in identity, shared in mission */}
  <Section eyebrow="Local in identity. Shared in mission.">
    <div class="measure" data-reveal>
      <p class="statement" style="font-size:var(--fs-h2);">
        City2City doesn't oversee local churches. It exists to help local
        churches collaborate.
      </p>
      <p class="prose" style="margin-top:1.5rem;">
        Every local work keeps its own leadership, identity, and responsibility.
        City2City lives in what happens between them:
      </p>
    </div>
    <ul class="practices" style="margin-top:2rem;max-width:52rem;" data-reveal>
      {collaboration.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </Section>

  {/* 5 — Multiplication (outward, not a hierarchy) */}
  <section class="section dark">
    <div class="container">
      <p class="eyebrow" data-reveal>
        Multiplication
      </p>
      <p class="prose" style="margin-top:1rem;" data-reveal>
        Not a hierarchy. Fruit spreading outward, city to city.
      </p>
      <div class="multiply" style="margin-top:2.5rem;" data-reveal>
        <span class="multiply__term">Disciples</span>
        <span class="multiply__arrow" aria-hidden="true">
          →
        </span>
        <span class="multiply__term">Churches</span>
        <span class="multiply__arrow" aria-hidden="true">
          →
        </span>
        <span class="multiply__term">Streams</span>
        <span class="multiply__arrow" aria-hidden="true">
          →
        </span>
        <span class="multiply__term">Hubs</span>
        <span class="multiply__arrow" aria-hidden="true">
          →
        </span>
        <span class="multiply__term">Cities</span>
      </div>
    </div>
  </section>

  {/* 6 — City to city (horizontal, decentralized) */}
  <section class="section">
    <div class="container split split--text-wide">
      <div class="stack" data-reveal>
        <p class="eyebrow">City to city</p>
        <h2 class="section__title" style="margin-top:0;">
          Strong local work. Real relationships across cities.
        </h2>
        <p class="prose">
          No headquarters. No one directing the work from above. Practitioners
          choosing to run together — sharing responsibility for multiplication
          beyond their own backyard.
        </p>
        <ul class="practices" aria-label="Cities collaborating as peers">
          <li>Your city</li>
          <li>Another city</li>
          <li>Another city</li>
        </ul>
      </div>
      <Figure
        data-reveal
        ratio="4 / 5"
        tone="clay"
        caption="Practitioners from different cities in conversation and prayer around a table."
      />
    </div>
  </section>

  {/* 7 — Immersions (relational, not recruitment) */}
  <section class="section dark">
    <div class="container split split--media-wide">
      <div class="stack" data-reveal>
        <p class="eyebrow">The front door</p>
        <h2 class="statement" style="max-width:14ch;">
          Come Get Your Boots Muddy
        </h2>
        <p class="lead">
          Spend time with practitioners doing the work. Go into the harvest
          together. See the rhythms up close, build real relationship, and learn
          from one another — and see where collaboration might lead.
        </p>
        <ol
          class="pathway"
          aria-label="From immersion to ongoing collaboration"
        >
          {immersionPath.map((step) => (
            <li>{step.label}</li>
          ))}
        </ol>
        <div style="margin-top:0.5rem;">
          <Button href={primaryCta.href} variant="ghost">
            {primaryCta.label}
          </Button>
        </div>
      </div>
      <Figure
        data-reveal
        ratio="4 / 5"
        tone="dark"
        caption="A small group going out into a neighborhood together — the harvest, not a classroom."
      />
    </div>
  </section>

  {/* 8 — Evidence */}
  <Section eyebrow="Evidence" title="Real work. Real cities.">
    <p class="prose">
      What God is doing through local churches and the relationships between
      them — added as practitioners share real stories and fruit. Never
      invented, never a directory of branches.
    </p>
    <div class="evidence" style="margin-top:2.5rem;">
      {cities.map((city) => (
        <div data-reveal>
          <p class="evidence__city">{city.name}</p>
          <p class="evidence__ph">Story &amp; fruit coming soon.</p>
        </div>
      ))}
    </div>
  </Section>

  {/* 9 — Larger vision */}
  <section class="section dark">
    <div class="container">
      <p class="eyebrow" data-reveal>
        The vision
      </p>
      <p class="statement" style="max-width:20ch;margin-top:1rem;" data-reveal>
        Multiplication spreading through local churches that increasingly run
        together, city to city.
      </p>
    </div>
  </section>

  {/* 10 — Final CTA */}
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2
        class="section__title"
        style="max-width:22ch;margin-inline:auto;"
        data-reveal
      >
        Are you pursuing multiplication in your city?
      </h2>
      <div
        style="margin-top:2rem;display:flex;justify-content:center;"
        data-reveal
      >
        <Button href={primaryCta.href} variant="primary">
          {primaryCta.label}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
