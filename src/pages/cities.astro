---
// Cities — where local practitioners are doing the work and collaborating with
// others. NOT a directory of City2City branches. Local churches keep their own
// identity and leadership. No invented cities, statistics, or testimonials.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Figure from "@/components/Figure.astro";
import { cities } from "@/data/cities";
---

<BaseLayout
  title="Cities — City2City"
  description="Places where practitioners are doing the work locally and collaborating with others across cities. Local churches with their own leadership — not branches."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-reveal>
        Cities
      </p>
      <h1 class="hero__title" data-reveal>
        Where the work is happening.
      </h1>
      <p class="lead hero__lead" data-reveal>
        Local churches and practitioners doing the work in their own cities —
        and choosing to collaborate with others. These aren't branches. Each is
        its own local work, with its own leadership.
      </p>
    </div>
  </section>

  <Section eyebrow="Across cities" title="Local works, running together.">
    <Figure
      data-reveal
      ratio="16 / 8"
      tone="dark"
      caption="A future map showing cities where practitioners are doing the work and collaborating — shown as peers, not a network chart. No locations until confirmed."
    />
  </Section>

  <Section eyebrow="Evidence" title="City by city">
    {cities.length === 0 ? (
      <p class="prose" data-reveal>
        Stories and fruit from local works will be added here.
      </p>
    ) : (
      <>
        <p class="prose" data-reveal>
          What God is doing through local churches and the relationships between
          them — added only as practitioners share real stories.
        </p>
        <div class="evidence" style="margin-top:2.5rem;">
          {cities.map((city) => (
            <div data-reveal>
              <p class="evidence__city">{city.name}</p>
              <p class="evidence__ph">Story &amp; fruit coming soon.</p>
            </div>
          ))}
        </div>
      </>
    )}
  </Section>
</BaseLayout>
