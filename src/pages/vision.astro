---
// Vision / About — the identity and framework. Editorial, restrained.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Progression from "@/components/Progression.astro";
import Button from "@/components/Button.astro";
import Figure from "@/components/Figure.astro";
import { primaryCta } from "@/data/nav";

const framework = [
  {
    eyebrow: "Essence",
    title: "Muddy boots",
    body: "Local leaders are actively doing the work — making disciples, leading at least a couple of churches, and pursuing multiplication in their city.",
  },
  {
    eyebrow: "Stewardship",
    title: "Fruit stewarded together",
    body: "Local bands steward their work together. Across cities we minimally steward baptisms, churches, and stream depth — honestly, never for show.",
  },
  {
    eyebrow: "Rhythms",
    title: "A shared life",
    body: "Regular city-to-city calls for prayer, stewardship, needs, support, learning, and planning — and an annual in-person gathering.",
  },
  {
    eyebrow: "Expansion",
    title: "New hubs emerge",
    body: "We want to see more functioning hub cities. Immersions are a primary way we identify practitioners and cities for deeper investment.",
  },
];

const pathway = [
  { label: "Immersion" },
  { label: "Discernment" },
  { label: "Investment" },
  { label: "Local practice" },
  { label: "Hub" },
];
---

<BaseLayout
  title="Vision — City2City"
  description="City2City is a church of churches: local practitioners pursuing multiplication in their cities and stewarding the work together, city to city."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-reveal>
        Vision
      </p>
      <h1 class="hero__title" data-reveal>
        A church of churches.
      </h1>
      <p class="lead hero__lead" data-reveal>
        Local churches and bands of practitioners making disciples, leading
        churches, and pursuing multiplication locally — collaborating across
        cities.
      </p>
    </div>
    <div class="container hero__media" data-reveal>
      <Figure
        ratio="16 / 8"
        tone="clay"
        caption="A wide, human shot of a city and its people — grounded, ordinary, alive."
      />
    </div>
  </section>

  <Section eyebrow="The framework" title="How this actually works." narrow>
    <div class="rows">
      {framework.map((part) => (
        <div class="split split--text-wide" data-reveal>
          <div>
            <p class="col__num">{part.eyebrow}</p>
            <h3 class="col__title" style="margin-top:0.35rem;">
              {part.title}
            </h3>
          </div>
          <p class="col__body" style="margin-top:0;">
            {part.body}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <section class="section dark">
    <div class="container">
      <p class="eyebrow" data-reveal>
        The pathway
      </p>
      <p class="lead" style="margin-top:1rem;max-width:34ch;" data-reveal>
        People don't simply join City2City. Relationship and alignment develop
        through doing the work together.
      </p>
      <div style="margin-top:2rem;" data-reveal>
        <Progression steps={pathway} ariaLabel="Pathway to becoming a hub" />
      </div>
      <div style="margin-top:2.5rem;" data-reveal>
        <Button href={primaryCta.href} variant="ghost">
          {primaryCta.label}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
