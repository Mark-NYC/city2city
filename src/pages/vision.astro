---
// Vision — the deeper explanation. City2City is collaboration between local
// works, not an organization over them. Detailed rhythms/stewardship live here
// (moved off the homepage), framed relationally — not as an admissions pipeline.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Progression from "@/components/Progression.astro";
import Button from "@/components/Button.astro";
import Figure from "@/components/Figure.astro";
import { primaryCta } from "@/data/nav";

const framework = [
  {
    eyebrow: "Essence",
    title: "Muddy boots",
    body: "It begins local. Practitioners actually making disciples, leading churches, and pursuing multiplication in their own city — carrying real responsibility, not just agreeing with the idea.",
  },
  {
    eyebrow: "Stewardship",
    title: "Watching the fruit together",
    body: "Each local work stewards what God has entrusted to it. Across cities we pay attention together — and where it helps, we keep honest track of simple signals like baptisms, churches, and stream depth. Not metrics for show.",
  },
  {
    eyebrow: "Rhythms",
    title: "A shared life",
    body: "Regular city-to-city calls — prayer, what God is doing, needs, support, learning, planning — and an annual in-person gathering to plan and go into the harvest together.",
  },
  {
    eyebrow: "Expansion",
    title: "Running with new cities",
    body: "As practitioners get close to the work and real relationship grows, collaboration can extend to new cities. It's relational, not recruitment.",
  },
];

// Public progression — relationship, not an organizational pipeline.
const immersionPath = [
  { label: "Immersion" },
  { label: "Relationship" },
  { label: "Shared practice" },
  { label: "Ongoing collaboration" },
];
---

<BaseLayout
  title="Vision — City2City"
  description="City2City is a church of churches: local churches keep their own identity and leadership, and collaborate with practitioners in other cities to pursue multiplication."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-reveal>
        Vision
      </p>
      <h1 class="hero__title" data-reveal>
        Local in identity. Shared in mission.
      </h1>
      <p class="lead hero__lead" data-reveal>
        A church of churches: local churches pursuing multiplication in their
        own cities, choosing to walk, pray, learn, and work with churches and
        practitioners in other cities.
      </p>
    </div>
    <div class="container hero__media" data-reveal>
      <Figure
        ratio="16 / 8"
        tone="clay"
        caption="A wide, human shot of a city and its people — grounded, ordinary, alive."
      />
    </div>
  </section>

  {/* The distinction, stated plainly */}
  <section class="section dark">
    <div class="container">
      <p class="statement" style="max-width:22ch;" data-reveal>
        City2City doesn't oversee local churches. It helps local churches
        collaborate.
      </p>
      <p class="lead" style="margin-top:1.5rem;max-width:40ch;" data-reveal>
        There's no headquarters, no hierarchy over the local work, and nothing
        to come under. The substance stays local. City2City is what happens in
        the relationships between local works.
      </p>
    </div>
  </section>

  <Section eyebrow="The framework" title="How this actually works." narrow>
    <div class="rows">
      {framework.map((part) => (
        <div class="split split--text-wide" data-reveal>
          <div>
            <p class="col__num">{part.eyebrow}</p>
            <h3 class="col__title" style="margin-top:0.35rem;">
              {part.title}
            </h3>
          </div>
          <p class="col__body" style="margin-top:0;">
            {part.body}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="A note on language" title="What we mean by a hub." narrow>
    <p class="prose" data-reveal>
      A hub isn't a chapter, a franchise, or a status City2City hands out. It
      simply describes enough local substance — practitioners and churches doing
      the work in a city — to collaborate meaningfully with others. You don't
      earn membership. You do the work locally, and run together city to city.
    </p>
  </Section>

  <section class="section dark">
    <div class="container">
      <p class="eyebrow" data-reveal>
        Getting close to the work
      </p>
      <p class="lead" style="margin-top:1rem;max-width:36ch;" data-reveal>
        People don't join City2City. Relationship and shared practice grow by
        doing the work together — and an immersion is where that usually starts.
      </p>
      <div style="margin-top:2rem;" data-reveal>
        <Progression
          steps={immersionPath}
          ariaLabel="From immersion to ongoing collaboration"
        />
      </div>
      <div style="margin-top:2.5rem;" data-reveal>
        <Button href={primaryCta.href} variant="ghost">
          {primaryCta.label}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
