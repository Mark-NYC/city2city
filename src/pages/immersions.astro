---
// Immersions — the front door, framed relationally. An immersion is a way to
// get close to the work and build relationship, NOT an application to join an
// organization. No fake events, no form backend, no SSR.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Progression from "@/components/Progression.astro";
import Figure from "@/components/Figure.astro";
import Button from "@/components/Button.astro";
import { primaryCta } from "@/data/nav";
import { immersions } from "@/data/immersions";

const dateFmt = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const fmtDate = (iso: string) => dateFmt.format(new Date(iso));

const immersionPath = [
  { label: "Immersion", note: "You are here" },
  { label: "Relationship" },
  { label: "Shared practice" },
  { label: "Ongoing collaboration" },
];
---

<BaseLayout
  title="Immersions — City2City"
  description="An immersion is a way to get close to practitioners doing the work, go into the harvest together, and build relationship — not an application to join."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-reveal>
        The front door
      </p>
      <h1 class="hero__title" data-reveal>
        Come Get Your Boots Muddy
      </h1>
      <p class="lead hero__lead" data-reveal>
        Come spend time with practitioners doing the work. Go into the harvest
        together. See the rhythms up close, build relationship, learn from one
        another — and see where collaboration might lead.
      </p>
      <div class="hero__actions" data-reveal>
        <Button href="#dates" variant="primary">
          See upcoming dates
        </Button>
      </div>
    </div>
    <div class="container hero__media" data-reveal>
      <Figure
        ratio="16 / 8"
        tone="dark"
        caption="Practitioners going into a neighborhood together during an immersion — the harvest, not a venue."
      />
    </div>
  </section>

  <Section eyebrow="What it is" title="Get close to the work." narrow>
    <div class="prose stack" data-reveal>
      <p>
        An immersion isn't a conference, a class, or an application. It's time
        with practitioners who have muddy boots, in a city where disciples and
        churches are actually multiplying.
      </p>
      <p>
        It's for practitioners already pursuing multiplication in their own city
        who want to build relationship with others doing the same.
      </p>
    </div>
  </Section>

  <Section id="dates" eyebrow="Upcoming" title="Dates &amp; locations">
    {immersions.length === 0 ? (
      <p class="prose" data-reveal>
        Upcoming immersion dates and locations will be posted here. Check back
        soon.
      </p>
    ) : (
      <div class="evidence" data-reveal>
        {immersions.map((event) => (
          <div>
            <p class="evidence__city">{event.city}</p>
            <p class="col__body" style="margin-top:0.35rem;">
              {fmtDate(event.startDate)}
              {event.endDate ? ` – ${fmtDate(event.endDate)}` : ""}
            </p>
          </div>
        ))}
      </div>
    )}
  </Section>

  <section class="section dark">
    <div class="container">
      <p class="eyebrow" data-reveal>
        Where it can lead
      </p>
      <p class="lead" style="margin-top:1rem;max-width:34ch;" data-reveal>
        No pipeline, no admission. Just relationship and shared practice that
        may grow into ongoing collaboration.
      </p>
      <div style="margin-top:2rem;" data-reveal>
        <Progression
          steps={immersionPath}
          ariaLabel="From immersion to ongoing collaboration"
        />
      </div>
    </div>
  </section>

  <Section eyebrow="Interested?" title="Tell us about your city." narrow>
    {/* Placeholder — no form backend yet; conversion mechanics still open. */}
    <p class="prose" data-reveal>
      A way to start a conversation (form or contact) will live here once we
      decide how best to follow up with practitioners. For now, the primary
      action points here.
    </p>
    <div style="margin-top:2rem;" data-reveal>
      <Button href={primaryCta.href} variant="primary">
        {primaryCta.label}
      </Button>
    </div>
  </Section>
</BaseLayout>
